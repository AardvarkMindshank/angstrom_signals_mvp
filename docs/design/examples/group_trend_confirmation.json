{
  "schema": "angstrom.group/1",
  "name": "Trend Confirmation",
  "question": "Is there a trend on the higher timeframes, and does the lower timeframe support it?",
  "members": [
    {
      "key": "trend_1d",
      "label": "Daily trend",
      "ref": {"id": "trend.direction", "version": 1, "timeframe": "1D", "params": {}},
      "role": "score",
      "weight": 1,
      "family": "price_trend",
      "transform": {"kind": "map", "version": 1, "map": {"up": 1, "down": -1, "mixed": 0}},
      "when_unavailable": "exclude"
    },
    {
      "key": "trend_4h",
      "label": "4-hour trend",
      "ref": {"id": "trend.direction", "version": 1, "timeframe": "4h", "params": {}},
      "role": "score",
      "weight": 1,
      "family": "price_trend",
      "transform": {"kind": "map", "version": 1, "map": {"up": 1, "down": -1, "mixed": 0}},
      "when_unavailable": "exclude"
    },
    {
      "key": "structure_1d",
      "label": "Daily swing structure",
      "ref": {"id": "structure.swings", "version": 1, "timeframe": "1D", "params": {"left": 5, "right": 5, "count": 6}},
      "role": "score",
      "weight": 1,
      "family": "price_structure",
      "transform": {"kind": "map", "version": 1, "field": "structure", "map": {"up": 1, "down": -1, "mixed": 0, "unknown": null}},
      "when_unavailable": "exclude"
    },
    {
      "key": "momentum_4h",
      "label": "4-hour momentum",
      "ref": {"id": "momentum.direction", "version": 1, "timeframe": "4h", "params": {}},
      "role": "condition",
      "family": "price_trend",
      "when_unavailable": "fail"
    },
    {
      "key": "regime_1d",
      "label": "Daily regime",
      "ref": {"id": "regime.observation", "version": 1, "timeframe": "1D", "params": {"confirm": 3, "window": 250}},
      "role": "context",
      "family": "regime",
      "when_unavailable": "ignore"
    }
  ],
  "score": {
    "method": "weighted_mean",
    "range": [-1, 1],
    "meaning": "Direction of trend evidence: +1 all scoring members up, -1 all down. Not a forecast.",
    "min_coverage": 0.67
  },
  "conditions": [
    {
      "key": "bullish_confirmed",
      "label": "Uptrend confirmed by 4-hour momentum",
      "kind": "confirmation",
      "rule": {"all": [
        {"score": {"gte": 0.5}},
        {"member": "momentum_4h", "eq": "up"}
      ]}
    },
    {
      "key": "bearish_confirmed",
      "label": "Downtrend confirmed by 4-hour momentum",
      "kind": "confirmation",
      "rule": {"all": [
        {"score": {"lte": -0.5}},
        {"member": "momentum_4h", "eq": "down"}
      ]}
    },
    {
      "key": "ranging_veto",
      "label": "Daily regime is ranging: trend readings are not meaningful",
      "kind": "veto",
      "rule": {"member": "regime_1d", "field": "state", "eq": "ranging"}
    }
  ],
  "notes": "Trend and momentum share price inputs (they agree about 80% of the time on development data), so momentum is a confirmation condition, not a second weighted vote. Both trend members are in one family; the agreement diagnostic counts families, not members."
}
