{
  "schema": "angstrom.group/1",
  "name": "Reversal Evidence",
  "question": "Is there independent evidence that the current move may be turning, and where?",
  "members": [
    {
      "key": "rsi_div_4h",
      "label": "4-hour RSI divergence",
      "ref": {"id": "ta.divergence.rsi", "version": 1, "timeframe": "4h",
              "params": {"left": 5, "right": 5, "min_gap": 5, "max_gap": 60, "lookback": 150, "active_bars": 30}},
      "role": "condition",
      "family": "momentum_divergence",
      "when_unavailable": "fail"
    },
    {
      "key": "macd_div_4h",
      "label": "4-hour MACD divergence",
      "ref": {"id": "ta.divergence.macd", "version": 1, "timeframe": "4h",
              "params": {"left": 5, "right": 5, "min_gap": 5, "max_gap": 60, "lookback": 150, "active_bars": 30, "line": "histogram"}},
      "role": "condition",
      "family": "momentum_divergence",
      "when_unavailable": "fail"
    },
    {
      "key": "breaks_4h",
      "label": "4-hour structure breaks",
      "ref": {"id": "structure.breaks", "version": 1, "timeframe": "4h", "params": {"left": 5, "right": 5, "lookback": 150}},
      "role": "condition",
      "family": "price_structure",
      "when_unavailable": "fail"
    },
    {
      "key": "zones_1d",
      "label": "Daily support and resistance",
      "ref": {"id": "levels.zones", "version": 1, "timeframe": "1D",
              "params": {"left": 5, "right": 5, "lookback": 300, "width_atr": 0.5, "min_touches": 2, "per_side": 3, "max_width_mult": 2.0}},
      "role": "levels",
      "family": "price_levels",
      "when_unavailable": "ignore"
    },
    {
      "key": "cmf_4h",
      "label": "4-hour Chaikin Money Flow",
      "ref": {"id": "volume.cmf", "version": 1, "timeframe": "4h", "params": {"length": 20}},
      "role": "context",
      "family": "volume",
      "when_unavailable": "ignore"
    }
  ],
  "score": null,
  "conditions": [
    {
      "key": "bullish_reversal_setup",
      "label": "Bullish reversal evidence from at least two independent families",
      "kind": "confirmation",
      "rule": {"count_families_at_least": 2, "of": [
        {"member": "rsi_div_4h", "events": {"type_in": ["regular_bullish"], "status": "confirmed"}},
        {"member": "macd_div_4h", "events": {"type_in": ["regular_bullish"], "status": "confirmed"}},
        {"member": "breaks_4h", "events": {"direction": "bullish", "kind_in": ["CHoCH"], "within_candles": 20}},
        {"member": "zones_1d", "field": "support.0.distance_atr", "lte": 1.0}
      ]}
    },
    {
      "key": "bearish_reversal_setup",
      "label": "Bearish reversal evidence from at least two independent families",
      "kind": "confirmation",
      "rule": {"count_families_at_least": 2, "of": [
        {"member": "rsi_div_4h", "events": {"type_in": ["regular_bearish"], "status": "confirmed"}},
        {"member": "macd_div_4h", "events": {"type_in": ["regular_bearish"], "status": "confirmed"}},
        {"member": "breaks_4h", "events": {"direction": "bearish", "kind_in": ["CHoCH"], "within_candles": 20}},
        {"member": "zones_1d", "field": "resistance.0.distance_atr", "lte": 1.0}
      ]}
    }
  ],
  "notes": "No composite score: the members are events and price levels, which do not average meaningfully. RSI and MACD divergences come from the same price swings, so they are one family and together count once. About half of divergences break their invalidation level within 30 candles on development data; this Group reports evidence, not a trade."
}
