{
  "schema": "angstrom.rule-fixtures/1",
  "note": "Worked cases for the counting contract (design section 3.4.1). Each item is already evaluated: its three-valued value, its support set (signal instances referenced anywhere inside it) and its lineage roots (union over those instances, lineage version 2). The first build's evaluator must reproduce every result.",
  "cases": [
    {"name": "repeated predicate counts once", "op": "count_at_least", "k": 2,
     "items": [{"value": true, "support": ["rsi_4h"], "roots": ["price"]},
               {"value": true, "support": ["rsi_4h"], "roots": ["price"]}],
     "expected": false},
    {"name": "overlapping compound expressions merge", "op": "count_at_least", "k": 2,
     "items": [{"value": true, "support": ["rsi_4h", "macd_4h"], "roots": ["price"]},
               {"value": true, "support": ["rsi_4h", "zones_1d"], "roots": ["price"]}],
     "expected": false},
    {"name": "transitive overlap merges three items", "op": "count_at_least", "k": 2,
     "items": [{"value": true, "support": ["rsi_4h", "macd_4h"], "roots": ["price"]},
               {"value": false, "support": ["macd_4h", "breaks_4h"], "roots": ["price"]},
               {"value": true, "support": ["breaks_4h"], "roots": ["price"]}],
     "expected": false},
    {"name": "true and unknown on different instances", "op": "count_at_least", "k": 2,
     "items": [{"value": true, "support": ["rsi_4h"], "roots": ["price"]},
               {"value": "unknown", "support": ["zones_1d"], "roots": ["price"]}],
     "expected": "unknown"},
    {"name": "true and unknown sharing a source", "op": "count_distinct_sources_at_least", "k": 2,
     "items": [{"value": true, "support": ["rsi_4h"], "roots": ["price"]},
               {"value": "unknown", "support": ["zones_1d"], "roots": ["price"]}],
     "expected": false},
    {"name": "true price and unknown ETF flows", "op": "count_distinct_sources_at_least", "k": 2,
     "items": [{"value": true, "support": ["rsi_4h"], "roots": ["price"]},
               {"value": "unknown", "support": ["btc_etf"], "roots": ["tftc_btc_etf"]}],
     "expected": "unknown"},
    {"name": "open interest shares price with trend", "op": "count_distinct_sources_at_least", "k": 2,
     "items": [{"value": true, "support": ["trend_1d"], "roots": ["price"]},
               {"value": true, "support": ["oi_price_1h"], "roots": ["derivatives", "price"]}],
     "expected": false},
    {"name": "two false and one unknown cannot reach two", "op": "count_at_least", "k": 2,
     "items": [{"value": false, "support": ["rsi_4h"], "roots": ["price"]},
               {"value": false, "support": ["macd_4h"], "roots": ["price"]},
               {"value": "unknown", "support": ["zones_1d"], "roots": ["price"]}],
     "expected": false},
    {"name": "two separate trues", "op": "count_at_least", "k": 2,
     "items": [{"value": true, "support": ["rsi_4h", "macd_4h"], "roots": ["price"]},
               {"value": true, "support": ["breaks_4h"], "roots": ["price"]},
               {"value": "unknown", "support": ["zones_1d"], "roots": ["price"]}],
     "expected": true}
  ]
}
