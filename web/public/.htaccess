# The page itself is always fetched fresh, so a new build shows at once; the built files have hashed names and keep.
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(json)$">
    Header set Cache-Control "max-age=300"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Robots-Tag "noindex"
</IfModule>
